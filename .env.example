# ==============================================================================
# Paddock Manager - Variables de Entorno (Plantilla de Configuración)
# ==============================================================================

# ── Base de Datos PostgreSQL ──
POSTGRES_DB=paddock_db
POSTGRES_USER=paddock_user
POSTGRES_PASSWORD=your_secure_password_here_min_16_chars
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ── Seguridad y Autenticación JWT ──
# Generar clave secreta de 64 caracteres en hexadecimal o base64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ── Puertos y Entorno ──
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
FRONTEND_PORT=80
SWAGGER_ENABLED=false

# ── HikariCP Pool (Producción) ──
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
